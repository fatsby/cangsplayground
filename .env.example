# Copy to .env (or let scripts/docker-up.sh generate it).
HOST_PORT=3100
# LAN URL that phones on the same network can open — QR codes point here.
PUBLIC_URL=http://192.168.1.10:3100
LOBBY_TTL_MINUTES=180
# Cloudflare Tunnel (optional): with a token set, scripts/docker-up.sh starts the tunnel and QR codes use TUNNEL_PUBLIC_URL.
TUNNEL_TOKEN=
TUNNEL_PUBLIC_URL=https://playground.fatsby.me
